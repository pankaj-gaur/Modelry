@model ImportResultViewModel
@{
    Layout = "_WizardLayout";
    ViewData["Title"] = $"{Model.What} created";
    ViewData["Step"] = Model.What == "Templates" ? "templates" : Model.What == "Pages" ? "pages" : "schemas";
    var r = Model.Result;
    var what = Model.What.ToLower();
}
<div class="step-head">
    <span class="step-no">@(Model.What == "Templates" ? "Step 5 of 8" : Model.What == "Pages" ? "Step 7 of 8" : "Step 4 of 8"), done</span>
    <h1>@(r.Cancelled ? $"Stopped – {r.Created} {what} created" : r.Failed > 0 ? $"{r.Created} {what} created, {r.Failed} need attention" : $"{r.Created} {what} created")</h1>
    <p class="lead">In @Model.FolderTitle. @(r.Skipped > 0 ? $"{r.Skipped} already existed and were left unchanged." : "")</p>
</div>
@if (r.Cancelled)
{
    <div class="alert alert--warn" role="status"><p>Items created before you stopped stay in the CMS. Run the check again – existing items are skipped and the rest are created.</p></div>
}
else if (r.Failed > 0)
{
    <div class="alert alert--error" role="alert"><p>Errors are listed first below. Fix them in the workbook or CMS, upload again and re-run – what already exists is skipped.</p></div>
}
<div class="tally"><span><b>@r.Created</b> created</span><span><b>@r.Skipped</b> skipped</span><span><b>@r.Failed</b> failed</span></div>
<div class="actions" style="margin-top:0">
    @if (Model.What == "Pages")
    {
        <a class="btn btn--primary" asp-controller="Pages" asp-action="Index">Create DXA Views and Pages for another page</a>
    }
    else
    {
        <partial name="_StepButtons" model='@(Model.What == "Templates" ? "templates" : "schemas")' />
    }
    <a class="btn" asp-action="Results" asp-route-id="@Model.ResultId">Download log (.xlsx)</a>
</div>
<h2 class="section-title">Log</h2>
<div class="table-wrap">
    <table class="data">
        <thead><tr><th>Time</th><th>Level</th><th>Step</th><th>Item</th><th>What happened</th><th>TCM URI</th></tr></thead>
        <tbody>
        @foreach (var e in r.Log.OrderBy(e => e.Level).ThenBy(e => e.TimeUtc))
        {
            <tr><td class="muted">@e.TimeUtc.ToLocalTime().ToString("HH:mm:ss")</td><td><span class="level level--@e.Level">@(e.Level == IssueLevel.Info ? "Done" : e.Level.ToString())</span></td><td>@e.Step</td><td>@e.Item</td><td>@e.Message</td><td class="muted small">@e.TcmUri</td></tr>
        }
        </tbody>
    </table>
</div>
