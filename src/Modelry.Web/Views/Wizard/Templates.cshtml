@model WizardData
@inject TridionSession Cms
@inject Microsoft.Extensions.Options.IOptions<Modelry.Core.Gateway.TemplateFieldOptions> Fields
@{
    Layout = "_WizardLayout";
    ViewData["Title"] = "Create templates";
    ViewData["Step"] = "templates";
    var s = Model.Summary!;
    var total = s.ComponentTemplates + s.PageTemplates;
}
@Html.AntiForgeryToken()
<div class="step-head">
    <span class="step-no">Step 5 of 6</span>
    <h1>Create templates</h1>
    @if (Cms.IsAem)
    {
        <p class="lead">In AEM, templates become editable templates with policies, and presentation lives in component code. See how your workbook maps below.</p>
    }
    else if (total == 0)
    {
        <p class="lead">Your workbook has no Templates sheet rows. Add them (see the sample workbook) and upload it again, or finish here.</p>
    }
    else
    {
        <p class="lead">@s.ComponentTemplates Component Templates and @s.PageTemplates Page Templates are cloned from DXA base templates you choose, then given their view, linked schemas and page schema.</p>
    }
</div>

@if (Cms.IsAem)
{
    <partial name="_AemMapping" model="Model" />
}
else if (total > 0)
{
    @if (Model.TemplateRun is { } run)
    {
        <div class="alert alert--info" role="status"><p>Last run in <b>@run.FolderPath</b>: @run.Created created, @run.Skipped skipped@(run.Failed > 0 ? $", {run.Failed} failed" : ""). Running again skips templates that already exist.</p></div>
    }
    <form asp-controller="Templates" asp-action="DryRun" method="post" data-needs-folder>
        <h2 class="section-title" style="margin-top:0">1. Where should they be created?</h2>
        <p class="muted">The template publication's <b>Building Blocks</b> folder. It must be able to see the schemas, directly or through BluePrint.</p>
        @{ ViewData["PickerId"] = "template-picker"; ViewData["InputName"] = "folderId"; }
        <partial name="_FolderPicker" view-data="ViewData" />

        <h2 class="section-title">2. Which templates should be cloned?</h2>
        <div class="row">
            <div class="field">
                <label for="baseCtId">Base Component Template</label>
                <select id="baseCtId" name="baseCtId" class="template-picker" data-kind="component" required><option value="">Choose a folder first</option></select>
                <span class="hint">An existing DXA Component Template. Its building blocks and metadata schema are copied.</span>
            </div>
            <div class="field">
                <label for="basePtId">Base Page Template</label>
                <select id="basePtId" name="basePtId" class="template-picker" data-kind="page" required><option value="">Choose a folder first</option></select>
                <span class="hint">An existing DXA Page Template.</span>
            </div>
        </div>

        <h2 class="section-title">3. Header and footer</h2>
        <div class="row">
            <div class="field">
                <label for="headerInclude">Header include page</label>
                <input id="headerInclude" name="headerInclude" value="@Fields.Value.DefaultHeaderInclude" />
            </div>
            <div class="field">
                <label for="footerInclude">Footer include page</label>
                <input id="footerInclude" name="footerInclude" value="@Fields.Value.DefaultFooterInclude" />
            </div>
        </div>
        <p class="hint">Used for Page Templates that don't list their own includes. Leave both empty to keep the base template's includes.</p>

        <label class="check" style="margin-top:24px">
            <input type="checkbox" name="applyRegionConstraints" value="true" />
            <span><b>Limit regions to these templates</b><br /><span class="muted small">Region schemas then accept only the Component Templates listed for them in the workbook. Only works where the region schemas belong to this publication.</span></span>
        </label>
        <input type="hidden" name="applyRegionConstraints" value="false" />

        <div class="actions">
            <button class="btn btn--primary" type="submit" disabled data-busy="Starting the check…">Check templates</button>
            <a class="btn btn--quiet" asp-action="Finish">Skip to finish</a>
        </div>
    </form>
}
else
{
    <div class="actions"><a class="btn btn--primary" asp-action="Finish">Finish</a><a class="btn btn--quiet" asp-action="Upload">Upload a new workbook</a></div>
}
@section Scripts { <script src="~/js/picker.js" asp-append-version="true"></script> }
