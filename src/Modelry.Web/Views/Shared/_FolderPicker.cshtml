@* Publication / folder picker. ViewData: PickerId, InputName, Label, Mode ("sg" = Structure Groups), Value + ValueLabel (preselected) *@
@{
    var id = ViewData["PickerId"] as string ?? "picker";
    var name = ViewData["InputName"] as string ?? "folderId";
    var sg = ViewData["Mode"] as string == "sg";
    var noun = sg ? "Structure Group" : "folder";
    var value = ViewData["Value"] as string;
    var valueLabel = ViewData["ValueLabel"] as string;
}
<div class="picker" data-picker data-mode="@(sg ? "sg" : "folder")" id="@id">
    <div class="picker__tree">
        <ul class="tree" role="tree" aria-label="Publications and folders"><li class="tree__empty">Loading publications…</li></ul>
    </div>
    <div class="picker__side">
        <input type="hidden" name="@name" class="picker__value" value="@value" required />
        <div>
            <span class="label muted small">Selected @noun</span>
            <p class="picker__selected" aria-live="polite">@(valueLabel ?? $"None yet – open a publication and choose a {noun}.")</p>
            <p class="picker__meta muted small"></p>
        </div>
        <div class="picker__new" hidden>
            <label class="small" for="@(id)-new">Create a sub-@(sg ? "Structure Group" : "folder") here</label>
            <div class="newfolder">
                <input id="@(id)-new" maxlength="255" placeholder="@(sg ? "Structure Group name" : "Folder name")" />
                <button type="button" class="btn btn--small">Create</button>
            </div>
        </div>
    </div>
</div>
