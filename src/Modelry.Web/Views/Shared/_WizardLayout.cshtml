@inject TridionSession Cms
@{
    Layout = "_Layout";
    ViewData["InWizard"] = true;
}
<div class="wizard">
    <nav class="rail" aria-label="Your progress">
        <partial name="_Rail" />
    </nav>
    <div class="wizard__main">
        @if (!Cms.IsAem && Cms.Capabilities.BuildUntested)
        {
            <div class="alert alert--warn" role="status"><p>Connected to @Cms.Capabilities.Display. Creating schemas, templates and pages is tested on Tridion Sites 10 – on 9.x, check the results in the CMS before relying on them.</p></div>
        }
        @if (TempData["Error"] is string err)
        {
            <div class="alert alert--error" role="alert"><p>@err</p></div>
        }
        @RenderBody()
    </div>
</div>
@section Scripts { @await RenderSectionAsync("Scripts", required: false) }
