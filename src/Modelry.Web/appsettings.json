{
  "Tridion": {
    "DefaultAuthMode": "Windows",
    "CoreServiceUrl": "https://{cms-host}/webservices/CoreService201701.svc/basicHttp",
    "AccessManagementTokenUrl": "https://{access-management-host}/access-management/connect/token",
    "Scope": "",
    "OAuthBinding": "basicHttp",
    "AllowHttpHosts": [],
    "ProxyUrl": "",
    "TimeoutSeconds": 300,
    "MaxReceivedMessageSize": 67108864,
    "AllowedHosts": [],
    "AllowDemoMode": true,
    "CheckInComment": "Created by Modelry",
    "SessionMinutes": 30,
    "MaxUploadMegabytes": 10,
    "CheckReuseMinutes": 30
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/modelry-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30
        }
      }
    ]
  },
  "AllowedHosts": "*",
  "Templates": {
    "CtViewField": "view",
    "CtControllerField": "controller",
    "CtActionField": "action",
    "CtRouteValuesField": "routeValues",
    "CtHtmlClassesField": "htmlClasses",
    "CtDynamicField": "",
    "CtDynamicTrueValue": "true",
    "CtDynamicFalseValue": "false",
    "PtViewField": "view",
    "PtIncludesField": "includes",
    "DefaultHeaderInclude": "system/include/header",
    "DefaultFooterInclude": "system/include/footer",
    "CheckInComment": "Created by Modelry"
  }
}